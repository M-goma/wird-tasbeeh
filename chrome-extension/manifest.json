{
  "manifest_version": 3,
  "name": "وِرد — تذكير التسبيح",
  "short_name": "وِرد",
  "version": "1.0.0",
  "description": "تذكير لطيف بالأذكار فوق صفحات الويب المفتوحة في Chrome.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "إعدادات وِرد", "default_popup": "options.html" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}

